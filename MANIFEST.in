include LICENSE README.md Changelog.md pyproject.toml
recursive-include opguard *.py *.yaml *.cpp *.cu
recursive-include doc *.md
recursive-include docs/assets *.gif *.py
recursive-include examples *.py *.json *.md *.patch *.tar.gz
recursive-include tests *.py *.yaml *.sh
global-exclude __pycache__ *.py[cod] *.so *.pyd
prune build
prune dist
